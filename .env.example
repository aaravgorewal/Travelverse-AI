# -----------------------------------------------------------------------------
# Travelverse AI - Complete Local Environment Configuration
# -----------------------------------------------------------------------------
# Copy this file to '.env' in the root directory before running docker-compose.

# -----------------
# Core
# -----------------
NODE_ENV=development
PORT=8000
APP_URL=http://localhost:5173

# -----------------
# Infrastructure
# -----------------
# Backend database connection
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/travelverse
# Caching and AI orchestration state
REDIS_URL=redis://redis:6379/0

# -----------------
# Security & JWT
# -----------------
# Run `openssl rand -hex 32` to generate a secure key
SECRET_KEY=super_secret_development_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# -----------------
# AI & Providers (Optional if MOCK_MODE=true)
# -----------------
# Get from Google AI Studio
GEMINI_API_KEY=""

# Get from Google Cloud Console
GOOGLE_MAPS_API_KEY=""

# TBO Holidays API Key (B2B Inventory)
TBO_API_KEY=""

# OpenWeatherMap API Key
WEATHER_API_KEY=""

# -----------------
# Feature Flags
# -----------------
# Set to 'true' to safely stub out Gemini, Google, Weather, and TBO APIs.
# The system will use cached mock JSON payloads to simulate a live environment.
MOCK_MODE=true
